# ─────────────────────────────────────────────
#  .env.example — Safe template for Bank-Backend
#  Copy this file to .env and fill in your values.
#  Never commit the real .env to source control.
# ─────────────────────────────────────────────

# ── Server ──────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB ──────────────────────────────────
MONGO_URI=

# ── JWT ──────────────────────────────────────
JWT_SECRET=

# ── Redis ────────────────────────────────────
REDIS_URL=

# ── SMTP (Nodemailer) ─────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
